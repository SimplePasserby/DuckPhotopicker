<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.duck.photopicker">

    <application
        android:label="Duck PhotoPicker"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Launcher activity – just exists to show the icon in the drawer -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Duck PhotoPicker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The actual redirector -->
        <activity
            android:name=".RedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">

            <!-- Steal GET_CONTENT (priority > 105) -->
            <intent-filter android:priority="120">
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.OPENABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- Steal PICK_IMAGES -->
            <!-- FIX #1: Add CATEGORY_OPENABLE to match the Android protocol
                 and ensure the activity actually intercepts these intents. -->
            <intent-filter android:priority="120">
                <action android:name="android.provider.action.PICK_IMAGES" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- Steal USER_SELECT_IMAGES_FOR_APP -->
            <!-- FIX #1: Same as above, add CATEGORY_OPENABLE. -->
            <intent-filter android:priority="120">
                <action android:name="android.provider.action.USER_SELECT_IMAGES_FOR_APP" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
